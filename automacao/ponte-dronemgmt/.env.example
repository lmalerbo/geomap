# Copie pra ".env" (nunca commitar o .env de verdade) e preencha.

# URL da API do GeoMap em produção (sem barra no final).
GEOMAP_API_URL=https://geomap-docker.onrender.com

# Mesmo valor configurado em PONTE_DM_TOKEN no Render (texto longo e
# aleatório — ver README.md).
PONTE_DM_TOKEN=

# Acesso ao DroneManagement — os mesmos valores que estavam no Render.
DRONEMGMT_BASE_URL=https://prd-dronemgmt.pedraagroindustrial.com.br
DRONEMGMT_FORM_ID=
DRONEMGMT_UNIT_ID=
# Usuário (não o e-mail) e senha da conta usada pra consultar/apontar.
DRONEMGMT_USUARIO=
DRONEMGMT_SENHA=
